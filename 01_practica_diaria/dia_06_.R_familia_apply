# Creemos una matriz de expresión de juguete para los ejemplos
set.seed(123)
matriz_exp <- matrix(rnorm(12, mean = 8, sd = 2), nrow = 4, ncol = 3)
rownames(matriz_exp) <- c("Gene_A", "Gene_B", "Gene_C", "Gene_D")
colnames(matriz_exp) <- c("Paciente_1", "Paciente_2", "Paciente_3")

# --- A. apply(X, MARGIN, FUN) ---
# MARGIN = 1 significa aplicar la función por FILAS (ej. calcular algo por Gen)
# MARGIN = 2 significa aplicar la función por COLUMNAS (ej. calcular algo por Paciente)

medianas_genes <- apply(matriz_exp, 1, median)      # Mediana de cada fila (gen)
sd_pacientes   <- apply(matriz_exp, 2, sd)          # Desviación estándar de cada columna (paciente)


# --- B. lapply(X, FUN) y sapply(X, FUN) ---
# Útiles para iterar sobre listas de vectores o columnas de un Data Frame.
lista_ensayos <- list(
  run_1 = c(1.2, 2.3, 1.1),
  run_2 = c(0.9, 4.5, 3.2, 1.1, 2.0),
  run_3 = c(2.1, 1.8)
)

# lapply() siempre devuelve una LISTA
largos_lista <- lapply(lista_ensayos, length) # Devuelve una lista de longitudes

# sapply() simplifica a un VECTOR numérico limpio si es posible
largos_vector <- sapply(lista_ensayos, length) # Devuelve: run_1 = 3, run_2 = 5, run_3 = 2


